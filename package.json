{
  "name": "pulsesync-example-addon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PulseSync React addon template built with the official SDK",
  "scripts": {
    "dev": "node ./scripts/dev-build.mjs",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "format": "prettier --write .",
    "sync": "node ./scripts/sync-addon.mjs",
    "build:sync": "yarn build && yarn sync"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pulsesync/addon-sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.6",
    "react": "19.2.4",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
